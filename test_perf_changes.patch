fn checked_pow10(exponent: usize) -> Result<i128, EvalError> {
    let mut value = 1_i128;
    for _ in 0..exponent {
        value = value
            .checked_mul(10)
            .ok_or_else(|| EvalError::new("decimal literal exceeded the supported range"))?;
    }
    Ok(value)
}
