+    #[test]
+    fn sonic_pi_exporter_returns_error_on_zero_cycles_sample() {
+        let source = "pattern = bd sn";
+        let module = eval_module(source, ReplMode::Loose).unwrap();
+        let pattern = module.get("pattern").unwrap().as_sample_pattern().unwrap();
+        let path = std::env::temp_dir().join(format!("test_sample_output_zero_{}.rb", unique_temp_suffix()));
+
+        let result = export_sample_pattern_to_sonic_pi(pattern, &path, 0);
+        assert!(result.is_err());
+        assert_eq!(result.unwrap_err().to_string(), "exporting requires at least one cycle");
+    }
