fn sample_event_json(event: &Event<crate::value::SampleEvent>) -> String {
    let mut s = String::new();
    s.push_str("    {\n");
    s.push_str(&format!("      \"start_num\": {},\n", event.part.start().numerator()));
    s.push_str(&format!("      \"start_den\": {},\n", event.part.start().denominator()));
    s.push_str(&format!("      \"start_float\": {},\n", f64::from(event.part.start())));
    s.push_str(&format!("      \"end_num\": {},\n", event.part.end().numerator()));
    s.push_str(&format!("      \"end_den\": {},\n", event.part.end().denominator()));
    s.push_str(&format!("      \"end_float\": {},\n", f64::from(event.part.end())));
    s.push_str(&format!("      \"sample\": \"{}\",\n", event.value.sample().escape_default()));
    s.push_str(&format!("      \"gain\": {},\n", event.value.gain()));
    s.push_str(&format!("      \"pan\": {},\n", event.value.pan()));
    s.push_str(&format!("      \"rate\": {},\n", event.value.rate()));
    s.push_str(&format!("      \"slice_start\": {},\n", event.value.slice_start()));
    s.push_str(&format!("      \"slice_end\": {},\n", event.value.slice_end()));

    if let Some(hpf) = event.value.hpf_cutoff_hz() {
        s.push_str(&format!("      \"hpf_cutoff_hz\": {},\n", hpf));
    } else {
        s.push_str("      \"hpf_cutoff_hz\": null,\n");
    }

    if let Some(lpf) = event.value.lpf_cutoff_hz() {
        s.push_str(&format!("      \"lpf_cutoff_hz\": {}\n", lpf));
    } else {
        s.push_str("      \"lpf_cutoff_hz\": null\n");
    }

    s.push_str("    }");
    s
}

fn number_event_json(event: &Event<f64>) -> String {
    let mut s = String::new();
    s.push_str("    {\n");
    s.push_str(&format!("      \"start_num\": {},\n", event.part.start().numerator()));
    s.push_str(&format!("      \"start_den\": {},\n", event.part.start().denominator()));
    s.push_str(&format!("      \"start_float\": {},\n", f64::from(event.part.start())));
    s.push_str(&format!("      \"end_num\": {},\n", event.part.end().numerator()));
    s.push_str(&format!("      \"end_den\": {},\n", event.part.end().denominator()));
    s.push_str(&format!("      \"end_float\": {},\n", f64::from(event.part.end())));
    s.push_str(&format!("      \"value\": {}\n", event.value));
    s.push_str("    }");
    s
}
