module = { SOI ~ padding ~ binding ~ padding ~ EOI }

binding = { binding_head ~ padding ~ "=" ~ padding ~ pipe_expr }
binding_head = { identifier ~ (required_padding ~ identifier)* }

pipe_expr = { sequence ~ (padding ~ pipe_op ~ padding ~ pipe_target)* }
pipe_target = { application }

sequence = { sum_expr ~ (required_padding ~ sum_expr)* }

sum_expr = { product_expr ~ (padding ~ add_op ~ padding ~ product_expr)* }
product_expr = { application ~ (padding ~ mul_op ~ padding ~ application)* }
application = { primary ~ call_suffix* ~ step_modifier* }
call_suffix = { "(" ~ padding ~ call_args? ~ padding ~ ")" }
primary = { graph | voice | stack | group | alternation | polymeter | rest | number | string | identifier }

// Mini-notation step operators bind tightly (no whitespace) to a sequence
// element: `bd*2` is repetition while `bd * 2` stays a binary product.
step_modifier = { repeat_modifier | slow_modifier | replicate_modifier | degrade_modifier }
repeat_modifier = { "*" ~ modifier_number }
slow_modifier = { "/" ~ modifier_number }
replicate_modifier = { "!" ~ modifier_number }
degrade_modifier = { "?" ~ modifier_number? }
modifier_number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

group = { "(" ~ padding ~ sum_expr ~ (required_padding ~ sum_expr)* ~ padding ~ ")" }

alternation = { "<" ~ padding ~ sum_expr ~ (required_padding ~ sum_expr)* ~ padding ~ ">" }

// Polymeter `{a b, c d e}%n`: comma-separated subsequences that each step at
// the shared per-cycle step count (the first subsequence's length unless the
// tight `%n` suffix overrides it).
polymeter = { "{" ~ padding ~ polymeter_group ~ (padding ~ "," ~ padding ~ polymeter_group)* ~ padding ~ "}" ~ polymeter_steps? }
polymeter_group = { sum_expr ~ (required_padding ~ sum_expr)* }
polymeter_steps = { "%" ~ modifier_number }

stack = { "stack" ~ "(" ~ padding ~ stack_layers ~ padding ~ ")" }
stack_layers = { pipe_expr ~ (padding ~ "," ~ padding ~ pipe_expr)* }

call_args = { call_arg ~ (padding ~ "," ~ padding ~ call_arg)* }
call_arg = { named_call_arg | pipe_expr }
named_call_arg = { identifier ~ padding ~ assign_op ~ padding ~ pipe_expr }

graph = { "graph" ~ padding ~ "{" ~ padding ~ graph_body? ~ padding ~ "}" }

// A named instrument definition sharing the graph block body shape: let
// bindings followed by one result expression (the mono voice signal).
voice = { "voice" ~ padding ~ "{" ~ padding ~ graph_body? ~ padding ~ "}" }
graph_body = { graph_entry ~ (padding ~ ";" ~ padding ~ graph_entry)* }
graph_entry = { graph_binding | graph_result }
graph_binding = { identifier ~ padding ~ assign_op ~ padding ~ pipe_expr }
graph_result = { pipe_expr }

identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
string = @{ "\"" ~ string_char* ~ "\"" }
string_char = { escape | !("\"" | NEWLINE) ~ ANY }
escape = { "\\" ~ ("\"" | "\\" | "n" | "r" | "t") }
rest = @{ "~" }
pipe_op = _{ "|>" }
add_op = { "+" }
mul_op = { "*" }
assign_op = _{ "=" }

padding = _{ (" " | "\t" | NEWLINE)* }
required_padding = _{ (" " | "\t" | NEWLINE)+ }
