+                if self.numerator < 0 { bias -= 1; }
+                if rhs.numerator > 0 { bias += 1; }
+                if rhs.numerator < 0 { bias -= 1; }
+                if bias >= 0 {
+                    Self::checked_normalize(i128::MAX, 1).unwrap()
+                } else {
+                    Self::checked_normalize(i128::MIN, 1).unwrap()
+                }
             }
